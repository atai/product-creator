{
  "kind": "feature",
  "component": "desktop",
  "feature": {
    "id": "project.workspace.open",
    "name": "Open projects",
    "bounded_context": "project",
    "entity": "workspace",
    "action": "open",
    "lifecycle": "implemented",
    "description": "Opens one or several project folders: from the command line, from the current folder or from the Workspace page.",
    "calls": [
      "project.layout.import"
    ],
    "source_file": "main/workspace.ts",
    "objects": [
      {
        "id": "project",
        "access": "read"
      }
    ],
    "actors": [
      "developer",
      "product_owner"
    ],
    "requirements": [
      {
        "id": "R1",
        "text": "`product-creator` opens the current folder; folders given as arguments open together"
      },
      {
        "id": "R2",
        "text": "The Workspace page adds and removes projects"
      }
    ],
    "acceptance": [
      {
        "id": "A1",
        "covers": [
          "R1"
        ],
        "text": "Folders from the command line open together, relative to where it was started",
        "verify": "pnpm --filter desktop test args"
      },
      {
        "id": "A2",
        "covers": [
          "R2"
        ],
        "text": "Projects are added and removed, and the next launch opens what was open",
        "verify": "pnpm --filter desktop test workspace"
      }
    ],
    "decisions": [
      {
        "id": "D1",
        "decision": "The workspace is remembered per OS user on each machine (workspace.json in the app data folder); dev and installed builds keep separate lists",
        "reason": "Current behaviour; projects are local folders, so a shared list would point to paths that do not exist elsewhere"
      }
    ],
    "tickets": [
      "PRODUCTCREATOR-6",
      "PRODUCTCREATOR-9"
    ]
  },
  "objects": [
    {
      "id": "project",
      "access": "read",
      "name": "Project",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "description": "Stable id, never changes"
        },
        {
          "name": "slug",
          "type": "string"
        },
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "description",
          "type": "text?"
        },
        {
          "name": "catalogRoot",
          "type": "string",
          "description": "Folder of the component catalogs, e.g. docs/product"
        },
        {
          "name": "components",
          "type": "component[]"
        },
        {
          "name": "vision",
          "type": "text?"
        },
        {
          "name": "goals",
          "type": "project.goal[]",
          "description": "G1… with text"
        },
        {
          "name": "actors",
          "type": "project.actor[]",
          "description": "id, name, description"
        },
        {
          "name": "glossary",
          "type": "project.glossary_term[]"
        },
        {
          "name": "tracker",
          "type": "json?",
          "description": "issueUrl with {id}"
        }
      ]
    }
  ],
  "calledBy": [],
  "workflows": [
    "project.onboard"
  ],
  "issues": []
}
