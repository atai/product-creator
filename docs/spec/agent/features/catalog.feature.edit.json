    "requirements": [
      {
        "id": "R1",
        "text": "A feature is saved to features/<context>/<entity>.<action>.yml of its component"
      },
      {
        "id": "R2",
        "text": "Spec fields (actors, requirements, acceptance, constraints, decisions, open questions) are saved with the card"
      },
      {
        "id": "R3",
        "text": "A save that adds a model error is rejected with the issues"
      }
    ],
    "acceptance": [
      {
        "id": "A1",
        "covers": [
          "R2"
        ],
        "text": "Reading a card and saving it back keeps every field",
        "verify": "pnpm --filter @pc/core test -- features"
      },
      {
        "id": "A2",
        "covers": [
          "R3"
        ],
        "given": "a feature whose calls name a missing feature",
        "when": "it is saved",
        "then": "the response is 400 with unknown_feature",
        "verify": "pnpm --filter @pc/core test -- features"
      }
    ],
    "code_refs": [
