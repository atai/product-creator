{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Business Object Schema",
  "required": [
    "id",
    "name",
    "owner",
    "lifecycle",
    "fields"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$",
      "description": "Unique identifier for the business object"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human readable name"
    },
    "description": {
      "type": "string",
      "description": "Summary of the business object"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "description": "Team or domain responsible for this object"
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "implemented",
        "deprecated",
        "removed"
      ],
      "description": "draft: being worked out; approved: spec agreed, ready to build; implemented: in the code; deprecated: still in the code, do not use in new work; removed: gone from the code, kept for history"
    },
    "active": {
      "type": "boolean",
      "description": "Whether the object is active. Inactive objects are not deleted but marked as inactive."
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Field identifier"
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "description": "Field data type"
          },
          "description": {
            "type": "string",
            "description": "Field purpose or behavior"
          }
        },
        "additionalProperties": false
      },
      "description": "Atomic fields for the object"
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Table name or storage target"
          },
          "description": {
            "type": "string",
            "description": "How the table is used"
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "type"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "description": "Physical columns defined in the table"
          }
        },
        "additionalProperties": false
      },
      "description": "Physical representations supporting this object"
    },
    "tickets": {
      "type": "array",
      "x-audience": "both",
      "default": [],
      "description": "Tracker issues this entry is planned or built in, e.g. PRODUCTCREATOR-34 (YouTrack/Jira key) or #12 (GitHub). Linked with tracker.issueUrl of product-creator.yml.",
      "items": {
        "type": "string",
        "pattern": "^([A-Z][A-Z0-9_]*-|#)[1-9][0-9]*$",
        "description": "Issue key: PROJECT-123 or #123"
      }
    }
  },
  "additionalProperties": false
}
