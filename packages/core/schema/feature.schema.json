{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Feature Schema",
  "description": "A Feature is a business capability of the product (formerly \"function card\"). Its implementation in code is `source_file` + `calls`.",
  "required": [
    "id",
    "name",
    "bounded_context",
    "entity",
    "action",
    "owner",
    "lifecycle"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+\\.[a-z0-9_]+$",
      "description": "Unique identifier in format: <bounded_context>.<entity>.<action>"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable name of the feature"
    },
    "bounded_context": {
      "type": "string",
      "minLength": 1,
      "description": "Bounded context this function belongs to"
    },
    "entity": {
      "type": "string",
      "minLength": 1,
      "description": "Entity this function operates on"
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "description": "Action performed by this function"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "description": "Team or individual responsible for this feature"
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "deprecated",
        "removed"
      ],
      "description": "Current lifecycle stage"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Tags for categorization"
    },
    "emits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Events emitted by this feature"
    },
    "consumes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Events consumed by this feature"
    },
    "apis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "method",
          "path"
        ],
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "default": [],
      "description": "API endpoints exposed by this feature"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the feature"
    },
    "calls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs of features this feature uses (derived from the calls of its code)"
    },
    "source_file": {
      "type": "string",
      "description": "Relative path of the source file that implements this feature"
    }
  }
}
