{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Feature Schema",
  "description": "A Feature is a business capability of the product (formerly \"function card\"). Its implementation in code is `source_file` + `calls`. Spec fields (actors, requirements, acceptance, constraints, decisions, open_questions) describe what the feature must do; `x-audience` marks who a field is for (human, agent or both).",
  "required": [
    "id",
    "name",
    "bounded_context",
    "entity",
    "action",
    "owner",
    "lifecycle"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+\\.[a-z0-9_]+$",
      "description": "Unique identifier in format: <bounded_context>.<entity>.<action>",
      "x-audience": "both"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable name of the feature",
      "x-audience": "both",
      "x-translatable": true
    },
    "bounded_context": {
      "type": "string",
      "minLength": 1,
      "description": "Bounded context this function belongs to",
      "x-audience": "both"
    },
    "entity": {
      "type": "string",
      "minLength": 1,
      "description": "Entity this function operates on",
      "x-audience": "both"
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "description": "Action performed by this function",
      "x-audience": "both"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "description": "Team or individual responsible for this feature",
      "x-audience": "human"
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "implemented",
        "deprecated",
        "removed"
      ],
      "description": "draft: being worked out; approved: spec agreed, ready to build; implemented: in the code; deprecated: still in the code, do not use in new work; removed: gone from the code, kept for history",
      "x-audience": "both"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Tags for categorization",
      "x-audience": "human"
    },
    "emits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Events emitted by this feature",
      "x-audience": "both"
    },
    "consumes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Events consumed by this feature",
      "x-audience": "both"
    },
    "apis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "method",
          "path"
        ],
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "default": [],
      "description": "API endpoints exposed by this feature",
      "x-audience": "both"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the feature",
      "x-audience": "both",
      "x-translatable": true
    },
    "calls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs of features this feature uses (derived from the calls of its code)",
      "x-audience": "agent"
    },
    "source_file": {
      "type": "string",
      "description": "Main implementation file, relative to the codeBasePath of the feature's component. Set by code sync; other places go to code_refs.",
      "x-audience": "agent"
    },
    "objects": {
      "type": "array",
      "description": "Business objects this feature reads or writes (ids of business objects). Validated: every id must exist.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "access"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Business object id"
          },
          "access": {
            "type": "string",
            "enum": [
              "read",
              "write"
            ],
            "description": "read: the feature only reads the object; write: creates, changes or deletes it"
          }
        },
        "additionalProperties": false
      },
      "x-audience": "both"
    },
    "actors": {
      "type": "array",
      "x-audience": "both",
      "default": [],
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Who uses the feature: roles of people or systems, e.g. \"project owner\", \"AI agent\", \"CI\""
    },
    "requirements": {
      "type": "array",
      "x-audience": "both",
      "description": "What the feature must do, one testable statement per item",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R[1-9][0-9]*$",
            "description": "Id inside the feature: R1, R2, … Referenced as <featureId>#R1. Never reuse a removed id."
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "The requirement: one testable statement (\"The app shows …\", \"The agent can …\")",
            "x-translatable": true
          },
          "priority": {
            "type": "string",
            "enum": [
              "must",
              "should",
              "could"
            ],
            "description": "MoSCoW priority; default must"
          }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "x-audience": "both",
      "description": "Acceptance criteria: how to check that the feature is done. Either given/when/then or text.",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^A[1-9][0-9]*$",
            "description": "Id inside the feature: A1, A2, … Referenced as <featureId>#A1. Never reuse a removed id."
          },
          "covers": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^R[1-9][0-9]*$"
            },
            "description": "Requirement ids (R1, …) this criterion checks; each must exist in requirements"
          },
          "given": {
            "type": "string",
            "minLength": 1,
            "description": "Precondition",
            "x-translatable": true
          },
          "when": {
            "type": "string",
            "minLength": 1,
            "description": "Action",
            "x-translatable": true
          },
          "then": {
            "type": "string",
            "minLength": 1,
            "description": "Expected result",
            "x-translatable": true
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "The criterion as one sentence, when given/when/then does not fit",
            "x-translatable": true
          },
          "verify": {
            "type": "string",
            "minLength": 1,
            "x-audience": "agent",
            "description": "How to verify automatically: a command or test reference, e.g. \"pnpm --filter @pc/core test validation\""
          }
        },
        "anyOf": [
          {
            "required": [
              "then"
            ]
          },
          {
            "required": [
              "text"
            ]
          }
        ]
      }
    },
    "constraints": {
      "type": "array",
      "x-audience": "both",
      "description": "Non-functional requirements and limits",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^C[1-9][0-9]*$",
            "description": "Id inside the feature: C1, C2, … Referenced as <featureId>#C1. Never reuse a removed id."
          },
          "kind": {
            "type": "string",
            "enum": [
              "performance",
              "security",
              "reliability",
              "compatibility",
              "usability",
              "compliance",
              "other"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "The constraint, measurable where possible (\"responds in < 200 ms\", \"works offline\")",
            "x-translatable": true
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "x-audience": "both",
      "description": "Decision records: what was decided for this feature and why",
      "items": {
        "type": "object",
        "required": [
          "id",
          "decision"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^D[1-9][0-9]*$",
            "description": "Id inside the feature: D1, D2, … Referenced as <featureId>#D1. Never reuse a removed id."
          },
          "decision": {
            "type": "string",
            "minLength": 1,
            "description": "What was decided",
            "x-translatable": true
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "Why; alternatives that were rejected",
            "x-translatable": true
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "YYYY-MM-DD"
          },
          "status": {
            "type": "string",
            "enum": [
              "accepted",
              "superseded"
            ],
            "description": "default accepted"
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "x-audience": "both",
      "description": "Questions not answered yet. An answered question becomes a decision.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^Q[1-9][0-9]*$",
            "description": "Id inside the feature: Q1, Q2, … Referenced as <featureId>#Q1. Never reuse a removed id."
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "description": "The question",
            "x-translatable": true
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "description": "Who answers it"
          }
        }
      }
    },
    "code_refs": {
      "type": "array",
      "x-audience": "agent",
      "default": [],
      "description": "Other places that implement the feature (UI page, API route, CLI command), in this or another component of the project",
      "items": {
        "type": "object",
        "required": [
          "component",
          "file"
        ],
        "additionalProperties": false,
        "properties": {
          "component": {
            "type": "string",
            "minLength": 1,
            "description": "Component slug (or id) the file belongs to"
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "description": "Path relative to the codeBasePath of that component"
          },
          "symbol": {
            "type": "string",
            "minLength": 1,
            "description": "Function, class or route in the file, if one"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "description": "What this place does for the feature, e.g. UI, API, CLI, storage"
          }
        }
      }
    },
    "tickets": {
      "type": "array",
      "x-audience": "both",
      "default": [],
      "description": "Tracker issues this entry is planned or built in, e.g. PRODUCTCREATOR-34 (YouTrack/Jira key) or #12 (GitHub). Linked with tracker.issueUrl of product-creator.yml.",
      "items": {
        "type": "string",
        "pattern": "^([A-Z][A-Z0-9_]*-|#)[1-9][0-9]*$",
        "description": "Issue key: PROJECT-123 or #123"
      }
    },
    "screens": {
      "type": "array",
      "x-audience": "both",
      "description": "Screenshots of the UI that illustrate the feature in the spec. Captured by the project's capture command (screenshots in product-creator.yml); wait/actions/element/viewport are hints for it.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S[1-9][0-9]*$",
            "description": "Id inside the feature: S1, S2, … The image is screens/<feature id>/<id>.png"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Caption of the screenshot in the spec",
            "x-translatable": true
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Route or URL path to open, relative to screenshots.baseUrl"
          },
          "wait": {
            "type": "string",
            "minLength": 1,
            "description": "CSS selector to wait for before capturing"
          },
          "actions": {
            "type": "array",
            "description": "Steps before capturing",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "maxProperties": 1,
              "properties": {
                "click": {
                  "type": "string",
                  "minLength": 1,
                  "description": "CSS selector to click"
                },
                "fill": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 2,
                  "maxItems": 2,
                  "description": "[CSS selector, value]"
                },
                "wait": {
                  "type": "string",
                  "minLength": 1,
                  "description": "CSS selector to wait for"
                }
              }
            }
          },
          "element": {
            "type": "string",
            "minLength": 1,
            "description": "CSS selector of the element to capture instead of the whole page"
          },
          "viewport": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 200,
              "maximum": 4000
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "[width, height] in CSS pixels"
          }
        }
      }
    },
    "i18n": {
      "type": "object",
      "x-audience": "both",
      "description": "Translations (PRODUCTCREATOR-37): i18n.<language> holds the translatable fields (x-translatable) in that language; list items are keyed by their id (or x-i18n-key); _source keeps fingerprints of the translated primary texts (set on save) to detect stale translations.",
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}
