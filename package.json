{
  "name": "product-creator-monorepo",
  "version": "0.1.3",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter desktop dev",
    "build": "pnpm --filter desktop build",
    "start": "pnpm --filter desktop start",
    "desktop": "pnpm --filter desktop dev",
    "desktop:build": "pnpm --filter desktop build",
    "desktop:start": "pnpm --filter desktop start",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "docs": "make -C docs html SPHINXOPTS=-W",
    "pc:dev": "pnpm --filter pc dev",
    "pc:build": "pnpm --filter pc build",
    "lint": "eslint apps/desktop packages/core packages/mcp",
    "desktop:dist": "pnpm --filter desktop dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.74.0"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  }
}
