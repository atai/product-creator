{
  "name": "product-creator-monorepo",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter desktop dev",
    "build": "pnpm --filter desktop build",
    "start": "pnpm --filter desktop start",
    "desktop": "pnpm --filter desktop dev",
    "desktop:build": "pnpm --filter desktop build",
    "desktop:start": "pnpm --filter desktop start",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "node --test scripts/version-manager.test.mjs && pnpm -r --if-present test",
    "docs": "make -C docs html SPHINXOPTS=-W",
    "lint": "eslint apps/desktop packages/core packages/mcp",
    "catalog:lint": "node apps/desktop/bin/product-creator.mjs lint . --warnings",
    "catalog:check": "node apps/desktop/bin/product-creator.mjs lint . --info",
    "catalog:spec": "node apps/desktop/bin/product-creator.mjs spec .",
    "desktop:dist": "pnpm --filter desktop dist",
    "version:current": "node scripts/version-manager.mjs current",
    "version:status": "node scripts/version-manager.mjs status",
    "version:help": "node scripts/version-manager.mjs help",
    "version:patch": "node scripts/version-manager.mjs patch",
    "version:minor": "node scripts/version-manager.mjs minor",
    "version:major": "node scripts/version-manager.mjs major",
    "version:prerelease": "node scripts/version-manager.mjs prerelease",
    "version:set": "node scripts/version-manager.mjs set"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "semver": "^7.7.3",
    "typescript-eslint": "^8.74.0"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  }
}
